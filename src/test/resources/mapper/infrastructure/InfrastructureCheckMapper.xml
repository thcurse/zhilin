<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhilin.mapper.infrastructure.InfrastructureCheckMapper">
    <!-- 只查询集成测试创建的连接级临时表，不接触业务表。 -->
    <select id="selectCheckById" resultType="com.zhilin.entity.infrastructure.InfrastructureCheckEntity">
        SELECT id, check_message
        FROM stage3_connection_check
        WHERE id = #{id}
    </select>
</mapper>
